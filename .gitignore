# Terraform state — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform lock file for S3 native locking
*.tflock

# Local variable overrides — contain real values, never commit
terraform.tfvars
*.auto.tfvars

# Terraform working directories
**/.terraform/
**/.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Terraform plan output files — may contain secrets
*.tfplan
*.plan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AWS credentials — never commit
.aws/
credentials
*.pem
*.key

# Environment files
.env
.env.*

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# OS
Thumbs.db
